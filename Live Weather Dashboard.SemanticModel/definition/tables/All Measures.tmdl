table 'All Measures'
	lineageTag: 6dde5ba6-506d-4fd5-92f9-1bd8c47d8a08

	measure Curr_Temp_C = sum('Current'[current.temp_c])& " °C"
		lineageTag: 3bacc4dd-15e9-4af7-a986-820d3ecef698

	measure Last_Updated_date_Curr = "Last Updated, "&FORMAT(FIRSTNONBLANK('Current'[current.last_updated],""), "dd mmm")
		lineageTag: 46cf2c96-3214-4439-960d-78daab6f1623

	measure Wind_Speed = sum('Current'[current.wind_kph])& " kph"
		lineageTag: 80fef7d3-5d10-4677-bf12-b7680a1744cd

	measure humidity = sum('Current'[current.humidity]) & " %"
		lineageTag: 38a8ab61-1227-41f3-8233-c3c857a599c7

	measure Pressure_mb = sum('Current'[current.pressure_mb]) & " mb"
		lineageTag: 4bbca198-340c-4b22-ba43-1842946a7de1

	measure Precipitation = sum('Current'[current.precip_mm]) & " mm"
		lineageTag: 4699aac4-fcf3-4f84-98ea-b4dd4be7efd3

	measure Visibility = sum('Current'[current.vis_km]) & " km"
		lineageTag: 89ff4dcd-beff-4cf8-8b45-148e4fb184a6

	measure For_Curr_Temp_C = AVERAGE(Forecast_days[forecast.forecastday.day.avgtemp_c])& " °C"
		lineageTag: ec6eb02d-738a-4670-861d-93242f2f90ac

	measure Left_Value_rain = 100 - SUM(Forecast_days[forecast.forecastday.day.daily_chance_of_rain])
		formatString: 0
		lineageTag: 2649efd0-36e5-48e4-a753-bc792a3a0821

	measure 'PM10 Color' =
			
			VAR AQI = ROUND(SELECTEDVALUE('Current'[current.air_quality.pm10]),0)
			RETURN
			SWITCH(
			TRUE(),
			AQI <= 50, "#43d946",
			AQI <= 100, "#fff570",
			AQI <= 150, "#ff9800",
			AQI <= 200, "#d99343",
			AQI <= 300, "#ff5b0f",
			"#d95243"
			)
		lineageTag: c97d13ff-b5b2-4d47-bd62-1e94fa69ad25

